--- a/drivers/gpu/drm/tiny/sharp-memory.c	2026-08-31 17:38:11.576264906 -0700
+++ b/drivers/gpu/drm/tiny/sharp-memory.c	2026-08-31 22:07:28.020097226 -0700
@@ -25,11 +25,25 @@
 #include <linux/mutex.h>
 #include <linux/pwm.h>
 #include <linux/spi/spi.h>
+#include <linux/slab.h>
+#include <linux/moduleparam.h>
 
 #define SHARP_MODE_PERIOD 8
 #define SHARP_ADDR_PERIOD 8
 #define SHARP_DUMMY_PERIOD 8
 
+/*
+ * NixVegas badge: cap each SPI transfer so a flush stays on the reliable
+ * PIO path. On this SG2000 the dw-axi-dmac multi-block path "Tx hanged
+ * up"s; transfers at or below the dw-spi FIFO depth run PIO and are
+ * solid. Runtime-tunable so the fastest reliable size can be found live:
+ *   echo N > /sys/module/sharp_memory/parameters/spi_chunk
+ * Default 8 is conservatively below any FIFO.
+ */
+static unsigned int spi_chunk = 8;
+module_param(spi_chunk, uint, 0644);
+MODULE_PARM_DESC(spi_chunk, "Max bytes per SPI transfer in a flush (PIO reliability)");
+
 #define SHARP_MEMORY_DISPLAY_MAINTAIN_MODE 0
 #define SHARP_MEMORY_DISPLAY_UPDATE_MODE 1
 #define SHARP_MEMORY_DISPLAY_CLEAR_MODE 4
@@ -85,11 +99,41 @@
 
 static inline int sharp_memory_spi_write(struct spi_device *spi, void *buf, size_t len)
 {
+	struct spi_transfer *xfers;
+	struct spi_message m;
+	unsigned int chunk = READ_ONCE(spi_chunk);
+	unsigned int n, nxfers;
+	size_t off;
+	int ret;
+
 	/* Reverse the bit order */
 	for (u8 *b = buf; b < ((u8 *)buf) + len; ++b)
 		*b = bitrev8(*b);
 
-	return spi_write(spi, buf, len);
+	if (!chunk)
+		chunk = len ? len : 1;
+
+	/*
+	 * ONE spi_message of <=spi_chunk transfers: each stays on the PIO
+	 * path, and one message holds the controller bus_lock_mutex for the
+	 * whole write so the userspace WS2812 painter (spidev, sharing SPI3 +
+	 * the CS net) cannot drive the shared CS high mid-flush. kvcalloc: the
+	 * array is large at a small chunk and the badge is memory-tight.
+	 */
+	nxfers = DIV_ROUND_UP(len, chunk);
+	xfers = kvcalloc(nxfers, sizeof(*xfers), GFP_KERNEL);
+	if (!xfers)
+		return -ENOMEM;
+
+	spi_message_init(&m);
+	for (n = 0, off = 0; off < len; n++, off += chunk) {
+		xfers[n].tx_buf = (u8 *)buf + off;
+		xfers[n].len = min_t(size_t, len - off, chunk);
+		spi_message_add_tail(&xfers[n], &m);
+	}
+	ret = spi_sync(spi, &m);
+	kvfree(xfers);
+	return ret;
 }
 
 static inline struct sharp_memory_device *drm_to_sharp_memory_device(struct drm_device *drm)
@@ -212,11 +256,19 @@
 	struct drm_rect clip;
 	struct sharp_memory_device *smd = drm_to_sharp_memory_device(fb->dev);
 
-	/* Always update a full line regardless of what is dirty */
+	/*
+	 * Force a FULL-FRAME flush. drm_fb_xrgb8888_to_mono offsets the source
+	 * by clip.y1 but writes to the TOP of dst (no dst clip offset), while
+	 * set_tx_buffer_addresses addresses from line 0 -- so a partial-height
+	 * damage (y1 > 0, which fbcon emits when a single line changes) would
+	 * write that content to the wrong Sharp lines. Flushing the whole frame
+	 * keeps fb row 0 mapped to line 1. (rect is ignored.)
+	 */
+	(void)rect;
 	clip.x1 = 0;
 	clip.x2 = fb->width;
-	clip.y1 = rect->y1;
-	clip.y2 = rect->y2;
+	clip.y1 = 0;
+	clip.y2 = fb->height;
 
 	sharp_memory_update_display(smd, fb, vmap, clip, fmtconv_state);
 }
