# Options NixOS + systemd require that the minimal vendor defconfig lacks.
# Merged onto the board defconfig via merge_config.sh; olddefconfig resolves deps.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# namespaces (systemd, containers)
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_USER_NS=y

# cgroups (systemd)
CONFIG_CGROUPS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_SCHED=y
CONFIG_CGROUP_BPF=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_BPF_SYSCALL=y

# seccomp (systemd sandboxing)
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# filesystems / vfs systemd + nixos need
CONFIG_OVERLAY_FS=y
CONFIG_AUTOFS_FS=y
CONFIG_FANOTIFY=y
CONFIG_FHANDLE=y
CONFIG_INOTIFY_USER=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y

# binfmt / exec
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_BINFMT_MISC=y

# keys / crypto systemd uses
CONFIG_KEYS=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_SHA256=y

# proc / sysfs / devtmpfs
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# epoll/eventfd/signalfd/timerfd (systemd)
CONFIG_EPOLL=y
CONFIG_EVENTFD=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

# wifi: point the AIC8800 in-tree driver at the NixOS firmware path
# (it uses filp_open, not request_firmware -- hardware.firmware installs the blobs there)
CONFIG_AIC_FW_PATH="/run/current-system/firmware/aic8800"

# Disable the warning-dirty vendor multimedia we do not need for wifi (and which
# uses APIs removed from 5.10, e.g. dc8000-fb's dma_alloc_writecombine).
# CONFIG_FB_CVITEK is not set
# CONFIG_FB_TFT is not set
# CONFIG_FB_TFT_ST7789V is not set

# Vendor hardware crypto not needed for wifi (and ships a broken -static test).
# CONFIG_CRYPTO_DEV_CVITEK_SPACC is not set

# Ensure the SD block device (mmcblk) exists for the rootfs.
CONFIG_MMC_BLOCK=y
