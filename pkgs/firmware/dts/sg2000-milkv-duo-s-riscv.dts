// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Device tree for the Milk-V Duo S RISC-V core (Sophgo SG2000, T-Head C906).
 *
 * The SG2000 die is the SG2002 family (cv181x/cv180x) with an added ARM core.
 * From the C906 the SoC is identical to the SG2002. The mainline sg2002.dtsi
 * applies directly.
 *
 * Based on arch/riscv/boot/dts/sophgo/sg2002-licheerv-nano-b.dts.
 *
 * Nodes included (boot-focused):
 *   - uart0: console at ttyS0, 115200n8.
 *   - sdhci0: SD card root (NIXOS_RISCV label), 4-bit bus.
 *   - osc: 25 MHz oscillator (same as LicheeRV Nano).
 *   - memory: overrides the sg2002.dtsi 256MB with 512MB
 *     (0x80000000/0x20000000) to match the firmware memory map.
 *   - Ethernet/gmac0: SG2000 internal EPHY (phy-mode = "internal"). No external
 *     PHY. The dtsi sets phy-handle=<&internal_ephy> and phy-mode="internal";
 *     enable the MAC and MDIO. Mirrors mainline cv1812h-huashan-pi.dts.
 *   - USB: dr_mode = "host" for the USB-A host port. VBUS enable is GPIO portb
 *     pin 5 (USB_VBUS_EN); upstream omits the regulator node.
 *
 * Nodes omitted:
 *   - LEDs, GPIO buttons, camera/CSI: not in the mainline sg2002 dtsi.
 *
 * The CPU (thead,c906, rv64imafdc, sv39) comes from cv180x-cpus.dtsi via
 * sg2002.dtsi.
 */

/dts-v1/;
#include "sg2002.dtsi"
#include <dt-bindings/gpio/gpio.h>

/*
 * Pin IDs and the pin controller.
 *
 * The Duo S carries an SG2000 die, not the SG2002 that sg2002.dtsi assumes.
 * The two packages have different pin tables and are not interchangeable:
 *
 *   pinctrl-sg2002.h   65 QFN pins, flat indices,   no VIVO pads
 *   pinctrl-sg2000.h  110 BGA pins, row/col coords, has VIVO pads
 *
 * For example UART0_TX is 18 on SG2002 but PINPOS('M', 5) on SG2000.
 *
 * SPI3 drives the WS2812 LED ring. The SPI3 pads are VIVO_D5..D8, which the
 * SG2002 table cannot name. Bind the pin controller to the SG2000 driver (see
 * the &pinctrl compatible override below) and give every pinmux an SG2000
 * coordinate. These identifiers match the ARM DTS, so both cores name the pads
 * the same way.
 *
 * Define the pads here rather than include pinctrl-sg2000.h. sg2002.dtsi
 * already includes pinctrl-sg2002.h, and the two headers define the same PIN_*
 * names with different values.
 */
#define PINPOS(row, col)	((((row) - 'A' + 1) << 8) + ((col) - 1))

#define DUOS_UART0_TX		PINPOS('M', 5)
#define DUOS_UART0_RX		PINPOS('M', 4)

#define DUOS_SD0_CLK		PINPOS('L', 1)
#define DUOS_SD0_CMD		PINPOS('L', 3)
#define DUOS_SD0_D0		PINPOS('L', 2)
#define DUOS_SD0_D1		PINPOS('K', 3)
#define DUOS_SD0_D2		PINPOS('M', 2)
#define DUOS_SD0_D3		PINPOS('M', 1)
#define DUOS_SD0_CD		PINPOS('K', 2)

#define DUOS_SD1_CLK		PINPOS('G', 14)
#define DUOS_SD1_CMD		PINPOS('G', 15)
#define DUOS_SD1_D0		PINPOS('H', 15)
#define DUOS_SD1_D1		PINPOS('H', 14)
#define DUOS_SD1_D2		PINPOS('F', 14)
#define DUOS_SD1_D3		PINPOS('G', 13)

/* SPI3 on the 40-pin header: pin19 MOSI, pin21 MISO, pin23 SCK, pin24 CS */
#define DUOS_VIVO_D5		PINPOS('B', 10)
#define DUOS_VIVO_D6		PINPOS('C', 10)
#define DUOS_VIVO_D7		PINPOS('B', 11)
#define DUOS_VIVO_D8		PINPOS('C', 11)

/ {
	model = "Milk-V Duo S";
	compatible = "milkv,duo-s", "sophgo,sg2002";

	aliases {
		serial0 = &uart0;
		/* The SPI core sets bus_num from of_alias_get_id(node, "spi")
		 * and falls back to dynamic numbering when no alias matches
		 * (drivers/spi/spi.c). Without this alias the only enabled
		 * controller takes bus 0 and spidev appears as /dev/spidev0.0. */
		spi3 = &spi3;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	/* Override the sg2002.dtsi 256MB with 512MB to match the firmware memmap. */
	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x20000000>;
	};

	/*
	 * OpenSBI stays resident in M-mode at 0x80000000 and PMP-protects its
	 * own memory from S-mode. Its boot banner states the regions:
	 *
	 *   Domain0 Region01 : 0x80000000-0x8003ffff M: (F,R,X) S/U: ()
	 *   Domain0 Region00 : 0x80040000-0x8005ffff M: (F,R,W) S/U: ()
	 *
	 * So 0x80000000..0x8005ffff (384 KB) is unreachable from Linux.
	 *
	 * OpenSBI normally patches an mmode_resv node into the device tree it
	 * hands onward. The boot chain is OpenSBI -> U-Boot -> a DTB loaded
	 * fresh from the FAT boot partition, so that fixup never reaches the
	 * DTB that Linux receives. Without this node the kernel treats the
	 * firmware memory as free RAM, hands out the page at 0x80000000, and
	 * faults when it zeroes that page (physical 0x80000000 maps to
	 * PAGE_OFFSET_L3, the base of the sv39 linear map).
	 *
	 * Reserve 512 KB, the 384 KB rounded up, to allow room for an OpenSBI
	 * version bump.
	 */
	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		mmode_resv0@80000000 {
			reg = <0x80000000 0x80000>;
			no-map;
		};
	};
};

&osc {
	clock-frequency = <25000000>;
};

/* Rebind the pin controller to the SG2000 driver so the VIVO pads exist. The
 * node (pinctrl@3001000) comes from sg2002.dtsi as "sophgo,sg2002-pinctrl".
 * Both drivers use the same register block but a different pin table.
 * CONFIG_PINCTRL_SOPHGO_SG2000 must be enabled in the kernel. */
&pinctrl {
	compatible = "sophgo,sg2000-pinctrl";

	uart0_cfg: uart0-cfg {
		uart0-pins {
			pinmux = <PINMUX(DUOS_UART0_TX, 0)>,
				 <PINMUX(DUOS_UART0_RX, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	sdhci0_cfg: sdhci0-cfg {
		sdhci0-clk-pins {
			pinmux = <PINMUX(DUOS_SD0_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <16100>;
			power-source = <3300>;
		};

		sdhci0-cmd-pins {
			pinmux = <PINMUX(DUOS_SD0_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-data-pins {
			pinmux = <PINMUX(DUOS_SD0_D0, 0)>,
				 <PINMUX(DUOS_SD0_D1, 0)>,
				 <PINMUX(DUOS_SD0_D2, 0)>,
				 <PINMUX(DUOS_SD0_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-cd-pins {
			pinmux = <PINMUX(DUOS_SD0_CD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	/* SPI3 for the WS2812 ring, mux 5 on the VIVO pads. Each subnode needs
	 * power-source: the mainline sophgo pinctrl rejects a pinmux subnode
	 * without it and fails pinctrl_bind_pins before dw_spi_mmio_probe runs. */
	spi3_cfg: spi3-cfg {
		spi3-sck-pins {
			pinmux = <PINMUX(DUOS_VIVO_D6, 5)>;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		spi3-sdo-pins {
			pinmux = <PINMUX(DUOS_VIVO_D8, 5)>;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		spi3-sdi-pins {
			pinmux = <PINMUX(DUOS_VIVO_D7, 5)>;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		/* CS is a GPIO here, not SPI3_CS. Mux 3 is XGPIOB_16; mux 5
		 * would be SPI3_CS. U10 gates LED_DIN with CS through an AND
		 * gate and needs CS active-high, which the native DW CS cannot
		 * do. See the cs-gpios comment on &spi3. */
		spi3-cs-pins {
			pinmux = <PINMUX(DUOS_VIVO_D5, 3)>;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};
};

/* SPI3 drives the WS2812 LED ring through spidev. cv180x.dtsi already declares
 * the controller (spi@41b0000) with its clocks, interrupt and RST_SPI3 reset;
 * it is only disabled. Enable it below. */
&spi3 {
	num-cs = <1>;
	/* No DMA. The mainline dw-axi-dmac cannot do slave DMA on this SoC.
	 * dw_axi_dma_set_hw_channel() programs the handshake number through a
	 * second register window (apb_regs), mapped only for compatibles with
	 * AXI_DMA_FLAG_HAS_APB_REGS. snps,axi-dma-1.01a has no such flag, and on
	 * the SG2000 the handshake selection lives in the dmamux instead. With
	 * dmas = <&dmamux 23 1>, <&dmamux 22 1> every slave prepare fails with
	 * "apb_regs not initialized". The IDs are correct (SPI3_TX 23, SPI3_RX
	 * 22, cpu 0 = CA53 / 1 = C906B); the driver support is not. Use PIO. */
	/* GPIO chip select, active-high. U10 wires LED_DIN = CS AND SDO, so the
	 * AND gate passes data only while CS is high.
	 *
	 * The native DW CS cannot do this. dw_spi_set_cs only decides whether to
	 * set the Slave Enable bit; SER is set regardless of active-high or
	 * active-low CS level, so the pad stays active-low and SPI_CS_HIGH has
	 * no effect. A gpiod CS honours polarity, and dw_spi sets
	 * SPI_CONTROLLER_GPIO_SS so SER is still raised and data still flows.
	 *
	 * VIVO_D5 is XGPIOB_16 at mux 3, hence the GPIO mux in &spi3_cfg. */
	cs-gpios = <&portb 16 GPIO_ACTIVE_HIGH>;
	pinctrl-0 = <&spi3_cfg>;
	pinctrl-names = "default";
	status = "okay";

	/* spidev binds known compatibles only. rohm,dh2228fv is in
	 * spidev_dt_ids and gives /dev/spidev3.0. */
	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <10000000>;
		/* Required for the U10 AND gate. The GPIO_ACTIVE_HIGH flag on
		 * cs-gpios does not decide polarity: gpiolib-of.c forces every
		 * SPI cs-gpio active-low unless the child node carries
		 * "spi-cs-high" (SPI children default to active-low chip
		 * selects). Without this the line comes up active-low, so CS
		 * goes low during transfers, the AND gate emits zero, and the
		 * LEDs receive nothing. */
		spi-cs-high;
	};
};

/*
 * GPIO line names, so gpioinfo reads as a wiring diagram instead of a list of
 * numbers.
 *
 * Names only. This sets no direction, no pull and no pad mux, so it cannot
 * change board behaviour. Every consumer still claims its own line.
 *
 * porta and portb are XGPIOA and XGPIOB. The board also uses a porte
 * (PWR_GPIO, the RTC domain block at 0x05021000) for the USER button and the
 * HDMI I2C pads. Mainline has no such controller node and pinctrl-sg2000.h
 * names only PWR_GPIO0..2, so those lines are not representable here.
 */
&porta {
	gpio-line-names =
		"",                  /* 0  CAM_MCLK0 (pin 12, NC) */
		"hdmi-5v-fault-n",   /* 1  U19 /FAULT */
		"", "", "", "", "", "",
		"", "",
		"",                  /* 10 SD_D1 */
		"", "",
		"sd-cd-n",           /* 13 SD card detect */
		"",
		"wifi-poweron",      /* 15 on-module AIC8800 */
		"",                  /* 16 UART0_TX */
		"",
		"jtag-tck",          /* 18 */
		"jtag-tms",          /* 19 */
		"jtag-trst",         /* 20 */
		"", "", "", "", "", "", "",
		"jtag-tdi",          /* 28 v1A datasheet swaps TDI/TDO */
		"jtag-tdo",          /* 29 */
		"usb-5v-fault-n",    /* 30 U5 /FAULT */
		"";
};

&portb {
	gpio-line-names =
		"pwm0-buck",         /* 0 */
		"adc3-j6",           /* 1  SARADC ch3 */
		"adc-vbat",          /* 2  SARADC ch2 */
		"adc-vsel",          /* 3  SARADC ch1 */
		"btn-boot-n",        /* 4  S1, also the ROM recovery strap */
		"usb-host-vbus-en",  /* 5  wired-AND with SERIAL_VBUS */
		"usb-vbus-det",      /* 6 */
		"", "", "", "",
		"core-sel-latch-clk",/* 11 U2 74AUP1G175 CP */
		"core-sel-latch-d",  /* 12 1=ARM, 0=RISC-V on next boot */
		"",                  /* 13 SPI3_SDO, LED chain via U10 */
		"",                  /* 14 SPI3_SDI */
		"",                  /* 15 SPI3_SCK */
		"",                  /* 16 SPI3_CS, gates LED_DIN via U10 */
		"sao-sda",           /* 17 IIC1 through U12 TXS0104E */
		"sao-scl",           /* 18 IIC1 */
		"sao-gpio2",         /* 19 */
		"sao-fault-n",       /* 20 U13 /FAULT */
		"sao-power-en",      /* 21 U13 EN + U12 OE */
		"sd-fault-n",        /* 22 U8 /FAULT */
		"core-sel-strap",    /* 23 readback: 1=RISC-V, 0=ARM */
		"", "", "", "", "", "", "", "";

	/* Enable the SAO connector power (U13 EN + U12 OE) at boot. */
	sao-power-en-hog {
		gpio-hog;
		gpios = <21 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "sao-power-en";
	};
};

/* Console UART */
&uart0 {
	pinctrl-0 = <&uart0_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

/* SD card (rootfs on NIXOS_RISCV label) */
&sdhci0 {
	pinctrl-0 = <&sdhci0_cfg>;
	pinctrl-names = "default";
	bus-width = <4>;
	no-1-8-v;
	no-mmc;
	no-sdio;
	disable-wp;
	status = "okay";
};

/* On-chip 10/100 Ethernet: SG2000 internal EPHY to the RJ45 magnetics, no
 * external PHY. Set phy-mode = "internal" with the internal EPHY handle and
 * enable the MAC and MDIO. Mirrors mainline cv1812h-huashan-pi.dts.
 * Note: mainline 7.0.x has no driver to power or init the internal EPHY, so
 * eth0 registers but does not link until the EPHY is initialized (in U-Boot or
 * a kernel driver). The DT is ready for that. */
&gmac0 {
	status = "okay";
	phy-mode = "internal";
	phy-handle = <&internal_ephy>;
};

&mdio {
	status = "okay";
};

/*
 * USB: SG2002/SG2000 DWC2 OTG core driving the USB-A host port.
 * dr_mode = "host" for the USB-A host port. USB_VBUS_EN = GPIO portb pin 5
 * gates VBUS, modelled as a fixed regulator so the port powers bus-powered
 * devices.
 */
/ {
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&portb 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};

&usb {
	dr_mode = "host";
	vbus-supply = <&usb_vbus>;
	status = "okay";
};

/*
 * Onboard WiFi: AICSemi AIC8800 on the SDIO bus mmc@4320000 (label sdhci1).
 * mmc@4310000 = SD card (sdhci0), mmc@4300000 = eMMC. GPIO PORTA pin 15
 * (WL_REG_ON, active-high) powers the AIC8800. The &sdhci1 poweron-gpios
 * raises it before the SDIO scan so the chip enumerates on the bus (vid
 * 0xC8A1). The out-of-tree aic8800 driver and firmware are separate.
 */
/ {
	/* A single consumer drives WL_REG_ON (porta15). Do not add a separate
	 * wifi_pwrseq: two consumers of porta15 route through gpio-shared-proxy
	 * (can_sleep), and aicbsp then drives WL_REG_ON with a non-sleeping
	 * gpiod_set_value. */

	/* Core VDD 3.3V OCR window. cv18xx-vsw takes bus I/O to 1.8V physically
	 * under NO_1_8_V, so there is no 1.8V vqmmc regulator. */
	wifi_vdd: regulator-wifi-vdd {
		compatible = "regulator-fixed";
		regulator-name = "aic8800-vdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

/*
 * WiFi SDIO bus pads. The mmc@4320000 controller uses the SD1 pads
 * (DUOS_SD1_*, mux 0 = SDIO1, same scheme as the SD0 pads for the card).
 * Without this mux the pads stay on their default function and the AIC8800
 * never answers the SDIO probe.
 */
&pinctrl {
	sdhci1_cfg: sdhci1-cfg {
		/* 1.8V pads. The AIC8800 VIO is fixed 1.8V; cv18xx-vsw drives the rail. */
		sdhci1-clk-pins {
			pinmux = <PINMUX(DUOS_SD1_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <16100>;
			power-source = <1800>;
		};

		sdhci1-cmd-pins {
			pinmux = <PINMUX(DUOS_SD1_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};

		sdhci1-data-pins {
			pinmux = <PINMUX(DUOS_SD1_D0, 0)>,
				 <PINMUX(DUOS_SD1_D1, 0)>,
				 <PINMUX(DUOS_SD1_D2, 0)>,
				 <PINMUX(DUOS_SD1_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};
	};
};

&sdhci1 {
	/* Vendor SDHCI: bind the cvitek cv181x host (cvitek,cv181x-sdio) so the
	 * AIC8800 fmac gets the vendor SDIO bring-up. clk_wifisd = SD1 functional
	 * clock (source, set from src-frequency); axi = register-bus clock.
	 * cv180x.dtsi provides the same CLK_SD1/CLK_AXI4_SD1 macros and &clk label
	 * as sg2000. */
	status = "okay";
	sophgo,sdio-inst1;
	compatible = "cvitek,cv181x-sdio";
	clocks = <&clk CLK_SD1>, <&clk CLK_AXI4_SD1>;
	clock-names = "clk_wifisd", "axi";
	bus-width = <4>;
	non-removable;
	no-mmc;
	no-sd;
	cap-sdio-irq;
	keep-power-in-suspend;
	/* 375MHz SDIO source clock (src-frequency, read by the cvi host). The
	 * card clock = f_max/4 = 46.875MHz at max-frequency = 187.5MHz;
	 * get_max_clock returns f_max as the sdhci divider base. */
	src-frequency = <375000000>;
	max-frequency = <187500000>;
	vmmc-supply = <&wifi_vdd>;
	pinctrl-0 = <&sdhci1_cfg>;
	pinctrl-names = "default";
	/* The cv181x host drives WL_REG_ON low at probe (card absent). The aic
	 * CONFIG_PLATFORM_CVITEK path raises it and calls cvi_sdio_rescan() to
	 * enumerate the fmac in bootrom mode so its message task starts. */
	poweron-gpios = <&porta 15 GPIO_ACTIVE_HIGH>;
};
