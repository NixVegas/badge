// SPDX-License-Identifier: (GPL-2.0 OR MIT)
/*
 * Device tree for the Milk-V Duo S (Sophgo SG2000, aarch64 ARM Cortex-A53).
 *
 * Based on mainline sg2000-milkv-duo-module-01-evb.dts.
 *
 * The Duo S uses the SG2000 SoM (Module 01) with a carrier board. This DTS
 * reuses the Module 01 DTSI, which enables eMMC, the sdhci1/WiFi stubs, and
 * aliases. It then adds the nodes that the Duo S carrier contributes:
 *   - uart0, enabled.
 *   - sdhci0, enabled for the SD card root.
 *   - chosen stdout-path for the ttyS0 console.
 *   - Ethernet: SG2000 internal EPHY (phy-mode = "internal"). The carrier has
 *     no external PHY. The DTSI sets phy-handle=<&internal_ephy> and
 *     phy-mode="internal". This DTS enables the MAC and MDIO.
 *   - USB: the usb node, enabled with dr_mode = "host". The carrier exposes a
 *     USB-A host port. GPIO portb pin 5 (USB_VBUS_EN) gates the port VBUS.
 *
 * Carrier nodes that are omitted:
 *   - LEDs and GPIO buttons: carrier-specific, not in the mainline sg2000 DTSI.
 *   - Camera/CSI: the ISP nodes are not in the mainline sg2000 DTSI.
 */

/dts-v1/;
#include "sg2000-milkv-duo-module-01.dtsi"
#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Milk-V Duo S";
	compatible = "milkv,duo-s", "sophgo,sg2000";

	chosen {
		stdout-path = "serial0:115200n8";
	};
};

/*
 * SoC reset for userspace `reboot`.
 *
 * The mainline sg2000.dtsi has no watchdog node, so mainline Linux registers
 * no restart handler for this SoC other than PSCI. The inherited /psci node
 * (arm,psci-0.2, method "smc") routes machine_restart to SYSTEM_RESET in BL31.
 * The SG2000 BL31 blob does not implement SYSTEM_RESET. The SMC returns and
 * machine_restart() spins forever after printing "reboot: Restarting system".
 *
 * The fix is to expose the CV1800B/SG2000 Synopsys DesignWare watchdog. The
 * mainline dw_wdt driver (CONFIG_DW_WDT) registers a restart handler at
 * priority 128. Its dw_wdt_restart() programs the shortest timeout in RESET
 * response mode and kicks the counter. This asserts the SoC watchdog-reset line.
 *
 * The watchdog reset output is gated in the always-on RTC block by
 * RTC_EN_WDT_RST_REQ (0x050260E0). The vendor FSBL (sophgo/fsbl plat/cv181x,
 * built by pkgs/firmware/fsbl.nix) writes 0x050260E0 = 1 in early platform
 * init. A watchdog timeout then propagates to a full SoC reset. Mainline Linux
 * does not clear that bit, so the watchdog restart handler resets the SoC.
 *
 * Node facts:
 *   - base 0x03010000, size 0x1000: from the vendor cv181x_base.dtsi
 *     "cv-wd@0x3010000" (compatible "snps,dw-wdt") and vendor u-boot
 *     WATCHDOG_BASE = TOP_BASE + 0x10000 = 0x03000000 + 0x10000.
 *   - clock CLK_APB_WDT (58): the mainline sophgo clk driver registers the
 *     clk_apb_wdt gate off the 25 MHz osc, matching the vendor
 *     CONFIG_DW_WDT_CLOCK_KHZ 25000. dw_wdt takes the first unnamed clock
 *     (devm_clk_get_enabled(dev, NULL)) as its timer clock.
 * `resets` is omitted. dw_wdt treats it as optional and the WDT is already out
 * of reset from u-boot. This avoids a dependency on the sophgo,cv1800b-reset
 * driver being built in.
 */
/* The mainline sg2000.dtsi gives the soc node no label, so merge by full path. */
/ {
	/* The SPI core sets bus_num from of_alias_get_id(node, "spi") and falls
	 * back to dynamic numbering when no alias matches. This alias fixes the
	 * controller to bus 3, so the device is /dev/spidev3.0 and not
	 * /dev/spidev0.0. */
	aliases {
		spi3 = &spi3;
	};

	soc {
		watchdog@3010000 {
			compatible = "snps,dw-wdt";
			reg = <0x03010000 0x1000>;
			clocks = <&clk CLK_APB_WDT>;
		};

		/* Reset controller. reset-simple handles sophgo,cv1800b-reset. The
		 * mainline sg2000.dtsi omits it. SPI3 comes up held in reset on the
		 * ARM core, so its register access stalls the dw_spi probe until the
		 * driver deasserts RST_SPI3. */
		rst: reset-controller@3003000 {
			compatible = "sophgo,cv1800b-reset";
			reg = <0x03003000 0x1000>;
			#reset-cells = <1>;
		};

		/* SPI3 (DesignWare APB SSI). The mainline sg2000.dtsi omits the SPI
		 * controllers, so this DTS defines the node. It is on the 40-pin
		 * header:
		 *   pin19 XGPIOB_13/SPI3_SDO(MOSI)  pin21 XGPIOB_14/SPI3_SDI(MISO)
		 *   pin23 XGPIOB_15/SPI3_SCK        pin24 XGPIOB_16/SPI3_CS
		 * The pads are VIVO_D5..D8, SPI3 = pinmux 5 (see &spi3_cfg). */
		spi3: spi@41b0000 {
			compatible = "snps,dw-apb-ssi";
			reg = <0x041b0000 0x10000>;
			#address-cells = <1>;
			#size-cells = <0>;
			interrupts = <SOC_PERIPHERAL_IRQ(41) IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&clk CLK_SPI>, <&clk CLK_APB_SPI3>;
			clock-names = "ssi_clk", "pclk";
			/* No reset. SPI3 is already out of reset from u-boot/FSBL, and
			 * the vendor arm64 DTS drives it with no reset. Mainline has no
			 * cv18xx reset header to verify an RST_SPI3 index against, so
			 * this DTS does not touch an unverified reset bit. */
			num-cs = <1>;
			/* No DMA. The mainline dw-axi-dmac cannot do slave DMA on
			 * this SoC. dw_axi_dma_set_hw_channel() programs the
			 * handshake number through a second register window (apb_regs),
			 * mapped only for compatibles that carry
			 * AXI_DMA_FLAG_HAS_APB_REGS. snps,axi-dma-1.01a has no such
			 * flag. On the SG2000 the handshake selection lives in the
			 * dmamux instead. With dmas set, every slave prepare fails with
			 *   dw_axi_dmac_platform 4330000.dma-controller: apb_regs not initialized
			 * and dw_spi retries per frame. The IDs are correct (SPI3_TX 23,
			 * SPI3_RX 22, cpu cell 0 = CA53 / 1 = C906B), but the driver
			 * support is not present. PIO is slower but boots reliably. */
			/* GPIO chip select, active high. The board wires
			 * LED_DIN = CS AND SDO through U10, and the AND gate only
			 * passes data while CS is high.
			 *
			 * The native DW CS cannot do this. dw_spi_set_cs only
			 * chooses whether to set the Slave Enable bit. SER is set
			 * regardless of active-high or active-low CS level, so the
			 * pad stays active-low in hardware and SPI_CS_HIGH has no
			 * effect on it.
			 *
			 * A gpiod CS honours polarity: spi_toggle_csgpiod() calls
			 * gpiod_set_value(desc, activate) and the GPIO library
			 * applies GPIO_ACTIVE_HIGH. dw_spi sets
			 * SPI_CONTROLLER_GPIO_SS, so the core still calls set_cs to
			 * raise SER and the transfer proceeds.
			 *
			 * VIVO_D5 is XGPIOB_16 at mux 3, so the pad is muxed as
			 * GPIO rather than SPI3_CS (see &spi3_cfg). */
			cs-gpios = <&portb 16 GPIO_ACTIVE_HIGH>;
			pinctrl-0 = <&spi3_cfg>;
			pinctrl-names = "default";
			status = "okay";

			/* spidev at /dev/spidev3.0. spidev only binds known
			 * compatibles; rohm,dh2228fv is in spidev_dt_ids. */
			spidev@0 {
				compatible = "rohm,dh2228fv";
				reg = <0>;
				spi-max-frequency = <10000000>;
				/* Required for the U10 AND gate. The
				 * GPIO_ACTIVE_HIGH flag on cs-gpios does not
				 * decide polarity. gpiolib-of.c forces every
				 * SPI cs-gpio active low unless the child node
				 * carries "spi-cs-high" (SPI children have
				 * active-low chip selects by default). Without
				 * this the line is active low, so CS goes low
				 * during transfers, the AND gate emits zero, and
				 * the LEDs receive no data. */
				spi-cs-high;
			};
		};
	};
};

/*
 * Pin configuration for the SD0 and UART0 pads. The pinmux matches the EVB
 * carrier.
 */
&pinctrl {
	/* SPI3 on the 40-pin header (pads VIVO_D5..D8, mux 5). The VIVO pads are
	 * 3.3V on the carrier, so power-source = <3300>. power-source is required:
	 * the mainline sophgo pinctrl (cv1800_dt_node_to_map_post) returns -EINVAL
	 * for any pinmux subnode that omits it. That fails pinctrl_bind_pins in
	 * really_probe before dw_spi_mmio_probe runs (silent EINVAL, no dev_err). */
	spi3_cfg: spi3-cfg {
		/* No bias-disable. The mainline sophgo pinctrl (sophgo_pconf_set)
		 * supports pull-up, pull-down, and bus-hold, but not BIAS_DISABLE,
		 * and returns -ENOTSUPP for it. That failure rolls back the whole
		 * pinctrl state, including the mux, and leaves the pins unclaimed.
		 * Omitting bias leaves the pad at its default (no pull), which suits
		 * a push-pull SCK/MOSI. */
		spi3-sck-pins {
			pinmux = <PINMUX(PIN_VIVO_D6, 5)>;
			power-source = <3300>;
		};
		spi3-sdo-pins {
			pinmux = <PINMUX(PIN_VIVO_D8, 5)>;
			power-source = <3300>;
		};
		spi3-sdi-pins {
			pinmux = <PINMUX(PIN_VIVO_D7, 5)>;
			bias-pull-up;
			power-source = <3300>;
		};
		/* CS is a GPIO here, not SPI3_CS. Mux 3 is XGPIOB_16; mux 5
		 * would be SPI3_CS. The board gates LED_DIN with CS through the
		 * U10 AND gate and needs it active high, which the native DW CS
		 * cannot do. See the cs-gpios comment on &spi3. */
		spi3-cs-pins {
			pinmux = <PINMUX(PIN_VIVO_D5, 3)>;
			bias-pull-up;
			power-source = <3300>;
		};
	};

	sdhci0_cfg: sdhci0-cfg {
		sdhci0-cd-pins {
			pinmux = <PINMUX(PIN_SD0_CD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-clk-pins {
			pinmux = <PINMUX(PIN_SD0_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <16100>;
			power-source = <3300>;
		};

		sdhci0-cmd-pins {
			pinmux = <PINMUX(PIN_SD0_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};

		sdhci0-data-pins {
			pinmux = <PINMUX(PIN_SD0_D0, 0)>,
				 <PINMUX(PIN_SD0_D1, 0)>,
				 <PINMUX(PIN_SD0_D2, 0)>,
				 <PINMUX(PIN_SD0_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	uart0_cfg: uart0-cfg {
		uart0-pins {
			pinmux = <PINMUX(PIN_UART0_TX, 0)>,
				 <PINMUX(PIN_UART0_RX, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <3300>;
		};
	};

	/*
	 * I2C2 (SG2000 IIC2) — LT8912B DSI->HDMI bridge control bus.
	 * Pads PIN_IIC2_SCL (ball J13) / PIN_IIC2_SDA (ball J14) = module pins
	 * 39/40, schematic net I2C_SENSOR1. IIC2 is the pads' PRIMARY function,
	 * so mux 0 selects it (same "named pad -> mux 0" pattern the working
	 * uart0/sd0 groups use; verified against the mainline sg2000 pin table,
	 * drivers/pinctrl/sophgo/pinctrl-sg2000.c: CV1800_GENERAL_PIN(PIN_IIC2_*)).
	 *
	 * power-source = <1800>, NOT 3300: both pads are IO_TYPE_1V8_ONLY in the
	 * VDDIO_RTC domain (same pin table). The mainline sophgo pinctrl records
	 * one power-cfg per domain (cv1800_set_power_cfg) and returns -EINVAL if a
	 * later pin in the SAME domain disagrees — but no other VDDIO_RTC pad is
	 * muxed on this board (uart0=EMMC, spi3=VIVO, sd0=SD0, sd1=SD1), so 1800
	 * is unambiguous. A 3300 here would both mis-set the 1V8 RTC rail and
	 * risk that -EINVAL rollback (which unclaims the whole group).
	 *
	 * No bias: I2C is open-drain with external 10k pull-ups (R20/R21). The
	 * sophgo pinctrl rejects bias-disable (-ENOTSUPP, rolls back the mux), and
	 * an internal pull is unnecessary given the board pull-ups, so bias is
	 * omitted entirely (pad default = no pull), mirroring the spi3 sck/sdo pins.
	 */
	iic2_cfg: iic2-cfg {
		iic2-scl-pins {
			pinmux = <PINMUX(PIN_IIC2_SCL, 0)>;
			power-source = <1800>;
		};
		iic2-sda-pins {
			pinmux = <PINMUX(PIN_IIC2_SDA, 0)>;
			power-source = <1800>;
		};
	};
};

/*
 * GPIO line names, so gpioinfo reads as a wiring diagram instead of a list of
 * numbers.
 *
 * Names only. This sets no direction, no pull, and no pad mux, so it cannot
 * change board behaviour. Every consumer still claims its own line.
 *
 * porta and portb are XGPIOA and XGPIOB. The board also uses a porte
 * (PWR_GPIO, the RTC domain block at 0x05021000) for the USER button and the
 * HDMI I2C pads. Mainline has no such controller node and pinctrl-sg2000.h
 * names only PWR_GPIO0..2, so those lines are not representable here.
 */
&porta {
	gpio-line-names =
		"",                  /* 0  CAM_MCLK0 (pin 12, NC) */
		"hdmi-5v-fault-n",   /* 1  U19 /FAULT */
		"", "", "", "", "", "",
		"", "",
		"",                  /* 10 SD_D1 */
		"", "",
		"sd-cd-n",           /* 13 SD card detect */
		"",
		"wifi-poweron",      /* 15 on-module AIC8800 */
		"",                  /* 16 UART0_TX */
		"",
		"jtag-tck",          /* 18 */
		"jtag-tms",          /* 19 */
		"jtag-trst",         /* 20 */
		"", "", "", "", "", "", "",
		"jtag-tdi",          /* 28 v1A datasheet swaps TDI/TDO */
		"jtag-tdo",          /* 29 */
		"usb-5v-fault-n",    /* 30 U5 /FAULT */
		"";
};

&portb {
	gpio-line-names =
		"pwm0-buck",         /* 0 */
		"adc3-j6",           /* 1  SARADC ch3 */
		"adc-vbat",          /* 2  SARADC ch2 */
		"adc-vsel",          /* 3  SARADC ch1 */
		"btn-boot-n",        /* 4  S1, also the ROM recovery strap */
		"usb-host-vbus-en",  /* 5  wired-AND with SERIAL_VBUS */
		"usb-vbus-det",      /* 6 */
		"", "", "", "",
		"core-sel-latch-clk",/* 11 U2 74AUP1G175 CP */
		"core-sel-latch-d",  /* 12 1=ARM, 0=RISC-V on next boot */
		"",                  /* 13 SPI3_SDO, LED chain via U10 */
		"",                  /* 14 SPI3_SDI */
		"",                  /* 15 SPI3_SCK */
		"",                  /* 16 SPI3_CS, gates LED_DIN via U10 */
		"sao-sda",           /* 17 IIC1 through U12 TXS0104E */
		"sao-scl",           /* 18 IIC1 */
		"sao-gpio2",         /* 19 */
		"sao-fault-n",       /* 20 U13 /FAULT */
		"sao-power-en",      /* 21 U13 EN + U12 OE */
		"sd-fault-n",        /* 22 U8 /FAULT */
		"core-sel-strap",    /* 23 readback: 1=RISC-V, 0=ARM */
		"", "", "", "", "", "", "", "";
};

/* Console UART */
&uart0 {
	pinctrl-0 = <&uart0_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

/*
 * I2C2 (IIC2) — control bus for the LT8912B DSI->HDMI bridge (BadgeOS #4, M1).
 * The mainline cv180x.dtsi defines i2c2 (i2c@4020000, snps,designware-i2c,
 * CLK_I2C/CLK_APB_I2C2, RST_I2C2) with status="disabled"; enable it and mux
 * the IIC2 pads (see &iic2_cfg). No child yet: the mainline lontium-lt8912b
 * DRM bridge cannot bind without a DSI host, so M1 only makes the bus visible
 * to i2c-tools (i2cdetect should ACK 0x48/0x49/0x4A). The DSI graph + bridge
 * node come with the DSI-host work (M3+).
 *
 * 100 kHz: the board uses 10k pull-ups (R20/R21); 400 kHz would violate the
 * I2C rise-time spec. The mainline node sets no clock-frequency (driver would
 * default to fast mode), so set it explicitly.
 */
&i2c2 {
	status = "okay";
	clock-frequency = <100000>;
	pinctrl-0 = <&iic2_cfg>;
	pinctrl-names = "default";
};

/* SD card (rootfs on /dev/mmcblk0, NIXOS_ARM label) */
&sdhci0 {
	bus-width = <4>;
	no-1-8-v;
	no-mmc;
	no-sdio;
	disable-wp;
	pinctrl-0 = <&sdhci0_cfg>;
	pinctrl-names = "default";
	status = "okay";
};

/* On-chip 10/100 Ethernet: SG2000 internal EPHY straight to the RJ45 magnetics.
 * The carrier has no external PHY. phy-mode is set to "internal" with the
 * internal EPHY handle. Note: mainline 7.0.x has no driver to power or init the
 * internal EPHY (no cv1800b dwmac glue, no EPHY phy driver), so eth0 registers
 * but does not link until the EPHY is initialized (for example in U-Boot) or a
 * kernel driver lands. */
&gmac0 {
	status = "okay";
	phy-mode = "internal";
	phy-handle = <&internal_ephy>;
};

&mdio {
	status = "okay";
};

/*
 * USB: SG2000 DWC2 OTG core driving the USB-A host port.
 * dr_mode is "host". The carrier exposes a USB-A host port.
 * VBUS to the port is gated by USB_VBUS_EN = GPIO portb pin 5, modelled as a
 * fixed regulator so the port powers bus-powered devices.
 */
/ {
	usb_vbus: regulator-usb-vbus {
		compatible = "regulator-fixed";
		regulator-name = "usb-vbus";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&portb 5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-boot-on;
	};
};

&usb {
	dr_mode = "host";
	vbus-supply = <&usb_vbus>;
	status = "okay";
};

/*
 * Onboard WiFi: AICSemi AIC8800 on the SDIO bus mmc@4320000 (label sdhci1).
 * mmc@4310000 = SD card (sdhci0), mmc@4300000 = eMMC. GPIO PORTA pin 15
 * (WL_REG_ON, active-high) powers the AIC8800, driven via the cvi host's
 * poweron-gpios. The out-of-tree aic8800 driver and firmware are separate.
 */
/ {
	/* WL_REG_ON must have one consumer. The cvitek host drives it via &sdhci1
	 * poweron-gpios. An mmc-pwrseq node on the same porta15 line would add a
	 * second consumer, which forces the kernel's can_sleep gpio-shared-proxy.
	 * aicbsp_set_subsys then calls the non-sleeping gpiod_set_value() on that
	 * proxy (gpiolib.c warns to use gpiod_set_value_cansleep) and mis-sequences
	 * the WL_REG_ON power enable. With one consumer, porta15 is a direct,
	 * non-sleeping gpiochip0 line and the power toggle is clean. */

	/* The AIC8800 core VDD reports a 3.3V OCR window in CMD5, so the mmc core
	 * must see vmmc as 3.3V or it rejects the card ("no support for card's
	 * volts", -EINVAL) before it powers. The bus I/O is taken to 1.8V in
	 * hardware by the cv18xx-vsw driver patch (SD_PWRSW_CTRL) under NO_1_8_V,
	 * matching the vendor, so there is no 1.8V vqmmc regulator. */
	wifi_vdd: regulator-wifi-vdd {
		compatible = "regulator-fixed";
		regulator-name = "aic8800-vdd";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};
};

/*
 * WiFi SDIO bus pads. The mmc@4320000 controller uses the SD1 pads
 * (PIN_SD1_*, mux 0 = SDIO1, the same scheme as the SD0 pads for the card).
 * Without this mux the pads stay on their default function and the AIC8800
 * does not answer the SDIO probe.
 */
&pinctrl {
	/* The AIC8800 SDIO IO (VIO) is fixed 1.8V on this board, so the SoC SD1
	 * pads must be in the 1.8V IO domain, not 3.3V. With power-source=3300 the
	 * pad domain mismatches the chip's 1.8V VIO, and the fmac firmware's
	 * higher-rate SDIO fails to confirm START_APP. Set 1800 to match.
	 */
	sdhci1_cfg: sdhci1-cfg {
		sdhci1-clk-pins {
			pinmux = <PINMUX(PIN_SD1_CLK, 0)>;
			bias-pull-up;
			drive-strength-microamp = <16100>;
			power-source = <1800>;
		};

		sdhci1-cmd-pins {
			pinmux = <PINMUX(PIN_SD1_CMD, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};

		sdhci1-data-pins {
			pinmux = <PINMUX(PIN_SD1_D0, 0)>,
				 <PINMUX(PIN_SD1_D1, 0)>,
				 <PINMUX(PIN_SD1_D2, 0)>,
				 <PINMUX(PIN_SD1_D3, 0)>;
			bias-pull-up;
			drive-strength-microamp = <10800>;
			power-source = <1800>;
		};
	};
};

&sdhci1 {
	/* This config routes the AIC8800 in-band SDIO interrupt (CARD_INT on DAT1)
	 * through the stock sdhci sdio_claim_irq path. With cap-sdio-irq and the
	 * driver claiming the IRQ, stock sdhci enables SDHCI_INT_CARD_INT and pins
	 * the controller runtime-resumed (pm_runtime_get_noresume in
	 * sdhci_enable_sdio_irq). The card clock then keeps toggling during the idle
	 * post-START_APP wait, so the fmac confirmation interrupt is sensed. */
	status = "okay";
	/* Marks this as the SD1/SDIO (wifi) instance for the cv18xx-vsw kernel
	 * patch. Its cv18xx_init sets FLAG_CV18XX_SD1 (reg_0x200[16] instance
	 * select and [8]/[9] reset-out in cv18xx_sdhci_reset) and FLAG_IO_FIXED_1V8
	 * (forces true 1.8V signalling). Without this the patched glue treats the
	 * node like an SD card and the SDIO-specific bring-up does not run. */
	sophgo,sdio-inst1;
	/* Binds the out-of-tree cvitek cv181x SDHCI host driver
	 * (pkgs/firmware/sdhci-cv181x) instead of mainline sdhci-of-dwcmshc, to
	 * reproduce the vendor SDIO bring-up the AIC8800 fmac needs. Replaces the
	 * inherited "sophgo,cv1800b-dwcmshc" compatible. clk_wifisd = SD1
	 * functional clock (driver sets it to max-frequency); axi = register-bus
	 * clock. */
	compatible = "cvitek,cv181x-sdio";
	/* List the functional clock (CLK_SD1, 375MHz) first, so sdhci_pltfm_init
	 * picks it (clocks[0], devm_clk_get(NULL)) as host->max_clk. With axi first
	 * the divider runs off 300MHz for a 37.5MHz card clock instead of the
	 * required 46.875MHz (375/8). The driver also looks both clocks up by name,
	 * so the order is safe. */
	clocks = <&clk CLK_SD1>, <&clk CLK_AXI4_SD1>;
	clock-names = "clk_wifisd", "axi";
	bus-width = <4>;
	non-removable;
	no-mmc;
	no-sd;
	/* The CONFIG_OOB=n driver needs the in-band SDIO interrupt. mmc_of_parse
	 * maps this to MMC_CAP_SDIO_IRQ, so sdhci wires up SDHCI_INT_CARD_INT. */
	cap-sdio-irq;
	/* Keep the SDIO function powered and stop the controller idling away the
	 * clock across the post-jump wait. */
	keep-power-in-suspend;
	/* Match the vendor 375MHz SDIO source clock (CLK_SD1 = clk_wifisd). The
	 * bootrom-to-fmac handoff and the cv18xx PHY tap timing are calibrated for
	 * a 375MHz functional clock. The vendor host reads this property
	 * (src-frequency) for the source rate, decoupled from max-frequency (the
	 * bus-clock ceiling). */
	src-frequency = <375000000>;
	/* The cv181x host's get_max_clock op returns f_max (this max-frequency) as
	 * sdhci's divider base (SDHCI_QUIRK_CAP_CLOCK_BASE_BROKEN), so the
	 * high-speed card clock is f_max/4. 187.5MHz gives 46.875MHz, which the
	 * fixed cv18xx PHY tap sample point requires. A lower rate shifts the sample
	 * point and corrupts the post-jump firmware message DMA. */
	max-frequency = <187500000>;
	/* The card core VDD OCR window is 3.3V (see wifi_vdd). The 1.8V bus I/O is
	 * done in hardware at the SoC pad rail by the cv18xx-vsw patch under
	 * NO_1_8_V, so there is no vqmmc regulator. A 1.8V vqmmc would pin ocr_avail
	 * to 1.8V and the core would reject the card's 3.3V OCR. */
	vmmc-supply = <&wifi_vdd>;
	pinctrl-0 = <&sdhci1_cfg>;
	pinctrl-names = "default";
	/* Do not auto-power the card via mmc-pwrseq, which would raise WL_REG_ON at
	 * boot and enumerate the card before the aic driver can drive it. Instead
	 * hand WL_REG_ON to the cv181x host driver as poweron-gpios. The driver
	 * drives it low at probe (card absent), then the aic CONFIG_PLATFORM_CVITEK
	 * path raises it and calls cvi_sdio_rescan() to enumerate the fmac in
	 * bootrom mode (CMD5 works). Its message task then starts and grants TX
	 * credits. */
	poweron-gpios = <&porta 15 GPIO_ACTIVE_HIGH>;
};
