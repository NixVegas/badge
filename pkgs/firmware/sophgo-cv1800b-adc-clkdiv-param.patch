--- a/drivers/iio/adc/sophgo-cv1800b-adc.c
+++ b/drivers/iio/adc/sophgo-cv1800b-adc.c
@@ -22,6 +22,22 @@
 
 #include <linux/iio/iio.h>
 
+/* Runtime-tunable SARADC sample timing. The badge reads its rails through
+ * 2.2M/1M dividers (~688k source impedance), which the fast ADC undersamples:
+ * the sample window is too short for the high-Z source to settle onto the S/H
+ * cap, so raw codes read low and nix-badge corrects with a large fudge factor.
+ * Raising clkdiv slows the ADC clock, lengthening the real-time sample window
+ * (= (sample_window+1) ADC clocks) so the divider settles further. Default to
+ * the max divider for best settling; sweep live with
+ * `modprobe sophgo-cv1800b-adc clkdiv=N` (0-15) and re-read in_voltage0_raw. */
+static unsigned int clkdiv = 15;
+module_param(clkdiv, uint, 0444);
+MODULE_PARM_DESC(clkdiv, "SARADC clock divider field 0-15 (ADC clk = fclk/(clkdiv+1)); higher = longer sample window");
+
+static unsigned int sample_window = 15;
+module_param(sample_window, uint, 0444);
+MODULE_PARM_DESC(sample_window, "SARADC sample-window field 0-15 (window = (sample_window+1) ADC clocks)");
+
 #define CV1800B_ADC_CTRL_REG				0x04
 #define	  CV1800B_ADC_EN				BIT(0)
 #define	  CV1800B_ADC_SEL(x)				BIT((x) + 5)
@@ -198,8 +214,8 @@
 		return ret;
 
 	writel(FIELD_PREP(CV1800B_MASK_STARTUP_CYCLE, 15) |
-	       FIELD_PREP(CV1800B_MASK_SAMPLE_WINDOW, 15) |
-	       FIELD_PREP(CV1800B_MASK_CLKDIV, 1) |
+	       FIELD_PREP(CV1800B_MASK_SAMPLE_WINDOW, sample_window & 0xf) |
+	       FIELD_PREP(CV1800B_MASK_CLKDIV, clkdiv & 0xf) |
 	       FIELD_PREP(CV1800B_MASK_COMPARE_CYCLE, 15),
 	       saradc->regs + CV1800B_ADC_CYC_SET_REG);
 
